{
  "name": "contrapasso",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "referee": "node server/index.ts",
    "test": "node scripts/simtest.ts && node scripts/refereetest.ts && node scripts/dueltest.ts && node scripts/bridgetest.mjs && node scripts/contract-rules-test.mjs && node scripts/markettest.mjs && node scripts/assettest.mjs",
    "assets": "node scripts/assets.mjs",
    "contract:build": "node scripts/contract-build.mjs",
    "near:prepare": "node scripts/near-prepare.ts",
    "near:deploy": "node scripts/near-deploy.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "contract:test": "node scripts/contract-test.mjs",
    "near:smoke": "node scripts/near-smoke.ts",
    "near:update": "node scripts/near-update.ts",
    "near:feature-smoke": "node scripts/near-feature-smoke.ts",
    "near:round": "node scripts/near-round.ts",
    "near:market-smoke": "node scripts/near-market-smoke.ts"
  },
  "overrides": {
    "tar": "7.5.23",
    "decode-uri-component": "0.5.1"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "near-api-js": "^7.5.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "near-contract-standards": "^2.0.0",
    "near-sdk-js": "^2.0.0",
    "near-workspaces": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
